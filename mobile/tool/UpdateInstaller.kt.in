package __PACKAGE__

import android.app.Activity
import android.app.PendingIntent
import android.content.Intent
import android.content.pm.PackageInstaller
import android.net.Uri
import android.os.Build
import android.provider.Settings
import androidx.core.content.FileProvider
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File

// نصب‌کنندهٔ داخل‌اپی — تزریق‌شده با tool/patch_update_install.sh.
//
// اندروید به اپِ عادی اجازهٔ نصبِ بی‌صدا نمی‌دهد. مسیرِ قبلی
// (ACTION_VIEW) روی خیلی از گوشی‌ها کاربر را می‌انداخت وسطِ تنظیماتِ
// «نصب از منبع ناشناس» و خودش برنمی‌گشت. این‌جا دو کارِ مجاز انجام
// می‌شود، نه دور زدنِ سیستم:
//
//   ۱. اگر اجازهٔ نصب برای خودِ قلقلی نیست، به‌جای نصب‌کنندهٔ گیج‌کننده
//      همان صفحهٔ تک‌کلیدِ این اپ باز می‌شود.
//   ۲. اگر اجازه هست، PackageInstaller جلسه می‌سازد. اگر سیستم اجازهٔ
//      ادامهٔ بی‌وقفه را بدهد، نصب جلو می‌رود؛ وگرنه فقط برگهٔ
//      «به‌روزرسانی» سیستم می‌آید، نه فهرستِ تنظیمات.
object UpdateInstaller {
    private const val CHANNEL = "ghelgheli/update"

    fun register(activity: Activity, engine: FlutterEngine) {
        MethodChannel(engine.dartExecutor.binaryMessenger, CHANNEL)
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "canInstallPackages" -> result.success(canInstall(activity))
                    "openInstallSettings" -> {
                        if (openInstallSettings(activity)) result.success("ok")
                        else result.error("settings-unavailable", "install settings unavailable", null)
                    }
                    "installApk" -> install(activity, call.argument<String>("path"), result)
                    else -> result.notImplemented()
                }
            }
    }

    private fun canInstall(activity: Activity): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return true
        return activity.packageManager.canRequestPackageInstalls()
    }

    private fun openInstallSettings(activity: Activity): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return true
        val intent = Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES).apply {
            data = Uri.parse("package:${activity.packageName}")
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        }
        return try {
            activity.startActivity(intent)
            true
        } catch (_: Exception) {
            false
        }
    }

    private fun install(activity: Activity, path: String?, result: MethodChannel.Result) {
        if (path.isNullOrEmpty() || !File(path).exists()) {
            result.error("not-found", "APK file not found", null)
            return
        }
        if (!canInstall(activity)) {
            result.success("needs-permission")
            return
        }
        val file = File(path)
        try {
            commitSession(activity, file)
            result.success("ok")
        } catch (_: Exception) {
            try {
                openPackageView(activity, file)
                result.success("ok")
            } catch (e: Exception) {
                result.error("install-failed", e.message, null)
            }
        }
    }

    private fun commitSession(activity: Activity, file: File) {
        val installer = activity.packageManager.packageInstaller
        val params = PackageInstaller.SessionParams(
            PackageInstaller.SessionParams.MODE_FULL_INSTALL,
        )
        params.setSize(file.length())
        params.setAppPackageName(activity.packageName)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            params.setRequireUserAction(PackageInstaller.SessionParams.USER_ACTION_NOT_REQUIRED)
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            params.setPackageSource(PackageInstaller.PACKAGE_SOURCE_LOCAL_FILE)
        }
        val sessionId = installer.createSession(params)
        val session = installer.openSession(sessionId)
        var committed = false
        try {
            session.openWrite("base.apk", 0, file.length()).use { out ->
                file.inputStream().use { input -> input.copyTo(out) }
                session.fsync(out)
            }
            val callback = Intent(activity, InstallResultReceiver::class.java)
            val flags = PendingIntent.FLAG_UPDATE_CURRENT or
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) PendingIntent.FLAG_MUTABLE else 0
            val pending = PendingIntent.getBroadcast(activity, sessionId, callback, flags)
            session.commit(pending.intentSender)
            committed = true
        } catch (e: Exception) {
            if (!committed) {
                try { session.abandon() } catch (_: Exception) {}
            }
            throw e
        } finally {
            try { session.close() } catch (_: Exception) {}
        }
    }

    private fun openPackageView(activity: Activity, file: File) {
        val uri = FileProvider.getUriForFile(
            activity,
            activity.packageName + ".ggFileProvider",
            file,
        )
        val intent = Intent(Intent.ACTION_VIEW).apply {
            setDataAndType(uri, "application/vnd.android.package-archive")
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }
        activity.startActivity(intent)
    }
}
