node_modules/
.env
.DS_Store
*.log
mobile/.dart_tool/
mobile/build/
mobile/android/
mobile/ios/
mobile/linux/
mobile/macos/
mobile/windows/
admin/dist/
backend/uploads/
apk/

# Build output (built on the server / in CI, never committed — a tracked
# dist/ makes `git pull` conflict on the VPS every deploy).
userweb/dist/

# ── signing material — never commit ────────────────────────────────────────
# The release keystore is the ONLY way to update an already-installed app.
# Committing it to a repo (even a private one) puts it in every clone and
# every CI cache. It lives in GitHub Actions secrets and offline copies.
*.jks
*.keystore
**/key.properties
__pycache__/

# حالتِ اجراییِ خودکارِ ظرفیت — روی سرور نوشته می‌شود، در گیت جایی ندارد.
# چرا در gitignore است و نه فقط بی‌تعقیب: deploy.sh بعد از reset --hard یک
# `git clean -fd` می‌زند و فایل‌های بی‌تعقیبِ *نادیده‌گرفته‌نشده* را پاک
# می‌کند. بدونِ این خط، هر انتشار «حافظهٔ ظرفیت» را پاک می‌کرد و اجرای بعدیِ
# تایمر دوباره از صفر تصمیم می‌گرفت (و nginx را بی‌دلیل بازنویسی می‌کرد).
backend/.capacity-state.json

# env variants — local/staging/production configs live on the VPS, not in git
.env.*
!.env.example

# Hidden sourcemaps — generated at build, archived privately by deploy.sh, never committed.
*.map
