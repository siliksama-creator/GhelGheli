NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ghelgheli:ghelgheli@localhost:5432/ghelgheli
JWT_SECRET=change_me_to_a_long_random_secret
# عمرِ جلسهٔ کاربرِ اپ/وب. «همیشگی» یعنی همین: ۱۰ سال.
# خواستهٔ مالک (۲۶ شهریور): کاربری که با شماره وارد شد، دیگر هر ماه بیرون
# نیفتد. توکنِ ادمین جداست و در کد ۱۲ ساعته است (پنلِ مدیریت دسترسیِ پول دارد).
# ⚠️ طولانی‌کردنِ این مقدار بی‌خطر است چون ستونِ `users.session_epoch`
#    (migration 092) کلیدِ خاموش‌کردنش را می‌دهد: هر تغییرِ رمز، همهٔ
#    توکن‌های قبلی را همان لحظه بی‌اعتبار می‌کند.
JWT_EXPIRES_IN=3650d
OTP_TTL_MINUTES=5
OTP_DEV_MODE=true
ADMIN_DEFAULT_USERNAME=Admin
# بدون مقدارِ واقعی seed:admin می‌شکند — پیش‌فرضِ عمومیِ رمز عمداً وجود ندارد (مخزن public است).
ADMIN_DEFAULT_PASSWORD=put_private_admin_password_here
TEST_USER_MOBILE=Admin
# اختیاری؛ اگر خالی بماند، همان رمزِ ابرادمین برای کاربر تستِ اپ استفاده می‌شود.
TEST_USER_PASSWORD=
MAIN_ADMIN_USERNAME=GhelGheli
MAIN_ADMIN_PASSWORD=put_private_owner_password_here
# یکی از این دو: JSON مستقیم یا مسیر فایل service account با permission=600.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
# در تولید، فهرستِ جدا با کاما از دامنه‌های مجاز — از جمله دامنهٔ
# فروشگاهِ وردپرسی، چون فوترِ سایت لینکِ دانلودِ تازه را با fetch از
# `/api/app/latest` می‌خواند (مهر ۱۴۰۵) و بدونِ این ردیف، مرورگر جلویش را
# می‌گیرد. نمونهٔ تولید:
# CORS_ORIGIN=https://admin.ghelghelishop.com,https://user.ghelghelishop.com,https://ghelghelishop.com,https://www.ghelghelishop.com
CORS_ORIGIN=http://localhost:5173

ALLOW_PASSWORD_REGISTRATION=false  # قراردادِ مهر ۱۴۰۵: ثبت‌نام با رمز بسته؛ عضویت فقط با OTP
DOCS_ACCESS_KEY=

# ── رمزگذاریِ فیلدهای مالی (شمارهٔ کارت / شبا / حسابِ قدیمی) ─────────────
# بدونِ این کلید، این فیلدها متنِ ساده در دیتابیس ذخیره می‌شوند و /health
# وضعیت را fieldCrypto.enabled=false نشان می‌دهد.
# ساختِ کلید:  node -e "console.log(require('./src/lib/fieldCrypto').generateKey())"
# ⚠️ اگر این کلید گم شود، مقدارهای رمزشده دیگر باز نمی‌شوند؛ یک نسخهٔ
#    پشتیبان از آن را جدا از دیتابیس نگه دارید.
FIELD_ENCRYPTION_KEY=
# فقط هنگامِ چرخشِ کلید: کلیدِ قبلی، تنها برای بازکردنِ داده‌های قدیمی.
FIELD_ENCRYPTION_KEY_OLD=

# ── سپرِ سرور (کلادفلر) — خواستهٔ مالک، ۲۶ شهریور ─────────────────────────
# توکنِ کلادفلر در پنلِ ادمین ذخیره می‌شود (رمزنگاری‌شده با FIELD_ENCRYPTION_KEY)،
# پس معمولاً چیزی این‌جا لازم نیست. این متغیر فقط برای آزمایش است:
# در تست‌ها به یک «کلادفلرِ جعلی» اشاره می‌کند تا هیچ‌وقت به حسابِ واقعی دست نزنیم.
# در تولید خالی بماند.
CF_API_BASE=
